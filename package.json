        "globals": "^17.11.0",
        "howler": "^2.2.4",
        "jsdom": "^29.1.1",
        "lefthook": "^2.1.10",
        "panzoom": "^9.4.4",
        "parse-duration": "^2.1.8",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "pretty-ms": "^9.3.0",
